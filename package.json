{
  "name": "arqa-shift-diary",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "app"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run start -w app",
    "build": "npm run build:web -w app",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:worker": "npm run build && npm run dev:worker -w server",
    "deploy": "npm run build && npm run db:migrate -w server && npm run deploy -w server"
  },
  "engines": {
    "node": ">=22.13"
  }
}
