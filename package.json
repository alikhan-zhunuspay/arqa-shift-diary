{
  "name": "arqa-shift-diary",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "app"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run start -w app",
    "build": "npm run build:web -w app",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:worker": "npm run build && npm run dev:worker -w server",
    "deploy": "npm run build && npm run build:worker && npm run db:migrate -w server && cd deploy/pages && wrangler pages deploy --project-name arqa-shift-diary --branch main",
    "build:worker": "esbuild server/src/worker.ts --bundle --format=esm --platform=neutral --main-fields=module,main --minify --outfile=app/dist/_worker.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
