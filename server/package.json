{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:worker": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply arqa-shift-diary --remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@shift-diary/core": "*",
    "hono": "^4.13.13",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  }
}
